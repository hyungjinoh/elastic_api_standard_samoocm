
{
  "settings": {
    "index": {
      "number_of_shards": 1,
      "number_of_replicas": 1,
      "max_ngram_diff": 20
    },
    "analysis": {
      "normalizer": {
        "lc_normalizer": {
          "type": "custom",
          "filter": [
            "lowercase"
          ]
        }
      },
      "tokenizer": {
        "ko_tokenizer": {
          "type": "nori_tokenizer",
          "decompound_mode": "mixed"
        },
        "ko_tokenizer_search": {
          "type": "nori_tokenizer",
          "decompound_mode": "none"
        }
      },
      "filter": {
        "ko_pos": {
          "type": "nori_part_of_speech"
        },
        "ko_readingform": {
          "type": "nori_readingform"
        },
        "ko_synonym": {
          "type": "synonym_graph",
          "synonyms": [
            "배치도, 배치평면도, 배치 도면",
            "감리보고서, 감리 보고서, 감리보고",
            "안전, 세이프티, safety",
            "환경부, 환경 부",
            "신축공사, 신축 공사, 신축"
          ],
          "lenient": true
        },
        "autocomplete_edge": {
          "type": "edge_ngram",
          "min_gram": 1,
          "max_gram": 20
        }
      },
      "analyzer": {
        "korean_index": {
          "type": "custom",
          "tokenizer": "ko_tokenizer",
          "filter": [
            "ko_pos",
            "ko_readingform",
            "lowercase"
          ]
        },
        "korean_search": {
          "type": "custom",
          "tokenizer": "ko_tokenizer_search",
          "filter": [
            "ko_pos",
            "ko_readingform",
            "lowercase",
            "ko_synonym"
          ]
        },
        "autocomplete_index": {
          "type": "custom",
          "tokenizer": "ko_tokenizer",
          "filter": [
            "lowercase",
            "autocomplete_edge"
          ]
        },
        "autocomplete_search": {
          "type": "custom",
          "tokenizer": "ko_tokenizer",
          "filter": [
            "lowercase"
          ]
        }
      }
    }
  },
