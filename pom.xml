<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- 3.5.16 -> 4.1.0
             3.5.x는 2026-06-30 오픈소스 EOL. 4.1.0(2026-06-10, Spring Framework 7.0.8 기반)은
             현재 지원 라인 최신이며 지원 종료 예정일 2027-07-31. Java 17 최소 요건 유지(21+ 권장).
             폐쇄망 Nexus에 더 최신 4.1.x 패치가 미러링되어 있으면 그 버전으로 상향할 것. -->
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.rayful.elastic.api</groupId>
    <artifactId>elastic_api_standard_samwoo_2</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>war</packaging>
    <name>elastic_api_standard</name>
    <description>ElasticSearch API</description>

    <properties>
        <!-- Spring Boot 4.1.0 최소 요건은 Java 17. 단, 가상 스레드/Project Leyden 등
             런타임 이점을 위해 Java 21 LTS 이상 권장(호환 상한 Java 26). 폐쇄망 JDK 정책과 맞춰
             21로 올릴 수 있으면 java.version을 21로 상향 검토. 현재는 기존 17 유지. -->
        <java.version>17</java.version>
        <!-- 포맷 지정 -->
	    <maven.build.timestamp.format>yyyy-MM-dd HH:mm:ss</maven.build.timestamp.format>
	    <!-- 타임존 강제 -->
	    <maven.build.timestamp.timezone>Asia/Seoul</maven.build.timestamp.timezone>

	    <!-- [버전 관리 방침]
	         과거 2.7.16 대응으로 수동 오버라이드했던 logback/slf4j/snakeyaml/spring-framework/
	         tomcat/netty 버전은 모두 제거된 상태. Spring Boot 4.1.0 BOM이 Spring Framework 7.0.8,
	         Tomcat 11.x, Jackson 3.x, 최신 Netty/Reactor/Logback 조합을 관리하므로 수동 오버라이드
	         금지(BOM이 검증한 조합을 깨뜨릴 위험). 개별 라이브러리는 BOM 관리 버전을 그대로 사용. -->
        <!-- [버그 수정] 여기 있던 <tomcat.version>/<netty.version> 프로퍼티 재선언을 삭제했다.
             Spring Boot 부모 POM(spring-boot-dependencies BOM)은 "tomcat.version"/"netty.version"
             이라는 동일한 이름의 프로퍼티로 자신의 BOM 내부 버전을 관리하는데, 자식 POM에서 같은 이름의
             프로퍼티를 다시 선언하면 Maven 프로퍼티 상속 규칙상 자식 값이 부모 BOM의 치환값을 조용히
             덮어써버린다. 그 결과 netty.version 이 존재하지 않거나(또는 다른 netty 모듈들과
             호환되지 않는) "4.2.18.Final" 로 강제되면서 netty-codec-base 등 일부 모듈을
             "Unresolved dependency" 로 만든 원인이었다. 바로 위 주석(35~39줄)에서 이미 "수동
             오버라이드 금지"를 못박아 둔 정책과도 모순되는 leftover 였으므로 제거하고,
             BOM이 검증한 조합(Spring Boot 4.1.1 관리 버전)을 그대로 쓰도록 되돌렸다.
             tomcat/netty 버전을 꼭 올려야 한다면 프로퍼티 재선언이 아니라
             spring-boot-starter-parent 자체의 버전을 올리는 방식으로 해야 한다. -->
        <jackson-bom.version>3.1.7</jackson-bom.version>      <!-- Jackson 3 (tools.jackson.core:*) -->
        <jackson-2-bom.version>2.21.7</jackson-2-bom.version> <!-- Jackson 2 (com.fasterxml.jackson.core:*) -->
    </properties>

    <!--
      ============================================================================
      [오픈소스 라이선스 / 유지보수 상태 요약]  (상세: docs/OSS_라이선스_검토보고서.md)
      ============================================================================
      1) 카피레프트(copyleft) 현황
         - GPL / AGPL(강한 카피레프트) : 없음  → 소스 공개 의무 트리거 없음
         - LGPL 2.1(약한 카피레프트) :
             · org.mariadb.jdbc:mariadb-java-client (직접 의존, JDBC 드라이버)
             · ch.qos.logback:logback-* (전이 의존, EPL-1.0 / LGPL-2.1 이중 라이선스 → EPL-1.0 선택 가능)
           → 두 라이브러리 모두 "동적 링크 + 별도 JAR 형태로 WEB-INF/lib에 포함"되어 있고,
             본 산출물은 폐쇄망 내부 배포(제3자 재배포 아님)이므로 LGPL 2.1 의무는 충족됨.
             (드라이버 소스를 수정/정적 포함하지 말 것. 교체 가능한 별도 JAR 유지.)
         - 그 외 직접/주요 전이 의존성 : Apache-2.0 / MIT / EPL 계열(허용적)
         - OSS 고지문(THIRD-PARTY-NOTICES)을 배포물에 동봉할 것.

      2) 유지보수 상태
         - Spring Boot 4.1.0(지원 라인)으로 이관 완료. 지원 종료 예정 2027-07-31.
           (기존 3.5.x는 2026-06-30 EOL이었음)
         - 4.x 동반 변경 반영됨: Spring Framework 7.0.8 / Tomcat 11 / Jackson 3 /
           mybatis-spring-boot-starter 4.0.1 / springdoc 3.0.x.

      3) Jackson 3 전환 유의
         - Spring Boot 4는 Jackson 3(groupId/패키지 tools.jackson.*)를 기본 JSON 라이브러리로 사용.
           본 프로젝트도 jackson-dataformat-xml을 tools.jackson.dataformat로 교체하고
           소스의 com.fasterxml.jackson.databind.* → tools.jackson.databind.* 로 수정함.
           (@JsonProperty 등 어노테이션은 예외적으로 com.fasterxml.jackson.annotation 유지)
      ============================================================================
    -->
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- [EcmDataSourceConfig 추가로 명시] org.springframework.boot.autoconfigure.jdbc.DataSourceProperties
             는 spring-boot-autoconfigure 모듈에 있는데, 이건 지금까지 mybatis-spring-boot-starter 가
             전이 의존성으로 끌고 와서(spring-boot-starter-jdbc 를 통해) 묵시적으로만 classpath 에 있었다.
             IDE가 전이 의존성 인덱싱을 제대로 못 따라가 "Cannot resolve symbol" 이 나길래, 아예 직접
             의존성으로 명시해서 어떤 환경에서도 확실히 잡히도록 했다(버전은 spring-boot-starter-parent
             BOM이 관리하므로 <version> 생략). pom.xml 추가 후 IDE에서 Maven 프로젝트 재임포트 필요. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
            <!-- 3.0.5 -> 4.0.1: mybatis-spring-boot 4.x 라인(= MyBatis-Spring 4.0, Spring Boot 4.x 대응).
                 3.0.x 라인은 Spring Boot 3.2~3.5 전용이라 SB4에서는 4.0.x 필수. Apache-2.0.
                 (4.0.1은 SB 4.0 기준 릴리즈이며 4.1과도 호환. 빌드 시 폐쇄망에서 회귀 확인 권장) -->
            <version>4.0.1</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.mariadb.jdbc</groupId>
            <artifactId>mariadb-java-client</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-tomcat</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>jcl-over-slf4j</artifactId>
        </dependency>
        <!-- Jackson 3: groupId가 com.fasterxml.jackson.dataformat -> tools.jackson.dataformat 로 변경됨.
             버전은 Spring Boot 4 BOM(tools.jackson:jackson-bom)이 관리하므로 명시하지 않음. -->
        <dependency>
            <groupId>tools.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-xml</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>commons-codec</groupId>
            <artifactId>commons-codec</artifactId>
        </dependency>
        <!-- jasypt-spring-boot-starter 3.0.5 -> 4.0.4
             [중요/기동 크리티컬] 3.0.5(2022)는 Spring Boot 4에서 기동 불가(내부적으로 이동/삭제된
             Spring 클래스 참조). 4.0.x가 Java 17 + 최신 Spring Boot 대응 라인이라 4.0.4로 상향.
             단, 이 스타터는 Spring Boot 부트스트랩 내부 이벤트에 의존하므로 SB 4.0/4.1에서
             기동 예외 사례(issue #417: ApplicationEnvironmentPreparedEvent 생성자 변경)가 보고된 바 있음.
             => 반드시 local 프로파일에서 ENC(...) DB자격증명 복호화가 정상 기동되는지 확인할 것.
             => 만약 4.0.4가 SB4.1에서 기동 실패하면, docs 체크리스트의 "Jasypt 폴백"(스타터 제거 +
                org.jasypt 코어 기반 커스텀 EnvironmentPostProcessor)으로 대체. ENC() 값/알고리즘은 그대로 유지됨. -->
        <dependency>
            <groupId>com.github.ulisesbocchio</groupId>
            <artifactId>jasypt-spring-boot-starter</artifactId>
            <version>4.0.4</version>
        </dependency>
        <!-- springfox-boot-starter(3.0.0) 제거 - 유지보수 중단(2020년 이후 릴리즈 없음),
             내장 swagger-ui에 CVE-2019-17495(CVSS 9.8) 등 심각한 XSS 취약점 확인됨.
             springdoc-openapi로 교체. Spring Boot 3.x(jakarta) 승급에 맞춰 2.x 라인 사용 -->
        <!-- springdoc 2.8.17 -> 3.0.3
             springdoc 2.x는 Spring Boot 3.x(SF6) 전용, 3.0.x가 Spring Boot 4.x(SF7) 대응 라인.
             SwaggerConfig의 org.springdoc.core.models.*, io.swagger.v3.oas.models.* 패키지는
             2.x/3.x 동일하여 소스 변경 불필요. 라이선스 Apache-2.0.
             [확인 필요] springdoc(내부 swagger-core)은 Jackson 2 어노테이션에 의존하므로 SB4(Jackson 3)와
             공존한다(좌표/패키지가 달라 충돌 아님). 다만 초기 3.0.x에서 기동 예외 사례(issue #3200)가
             보고된 바 있으니, 폐쇄망 반입 전 local 프로파일에서 swagger-ui 기동을 반드시 검증할 것.
             참고: 운영(prod)에서는 어차피 springdoc.api-docs/swagger-ui.enabled=false 로 비활성화됨. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.0.3</version>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- [wjg-loader 병합 — com.rayful.elastic.api.loader.*] 공식 Elasticsearch Java API 클라이언트.
             wjg-backend 의 색인/샘플데이터 적재 코드(IndexInitializer/IndexingService/SampleDataLoader 등)를
             그대로 재사용하기 위해 추가. 표준 검색 플로우(StandardSearchServiceImpl 등)는 이 클라이언트를
             쓰지 않고 기존 WebClient 기반 그대로라 서로 영향 없음.
             Jackson 2(com.fasterxml.jackson) 기반이라 이 프로젝트의 기본 Jackson 3(tools.jackson)과는
             좌표/패키지가 달라 공존 가능(springdoc 이 이미 쓰고 있는 것과 동일한 패턴) — 단, 폐쇄망 반입 전
             local 프로파일에서 기동 검증 필수(§ docs 체크리스트 참고). -->
        <dependency>
            <groupId>co.elastic.clients</groupId>
            <artifactId>elasticsearch-java</artifactId>
            <version>8.15.3</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <!-- application-*.yml 포함 필터링 -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>application-*.yml</include>
                    <include>logback-spring.xml</include>
                </includes>
            </resource>
            <!-- 나머지는 필터링 없이 -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>application-*.yml</exclude>
                    <exclude>logback-spring.xml</exclude>
                </excludes>
            </resource>
        </resources>

        <plugins>

            <!-- 라이선스(GPL/AGPL 등) 위반 여부 확인용.
                 [폐쇄망/오프라인 대응] download-licenses 골은 각 의존성 라이선스 원문을 인터넷(gnu.org 등)에서
                 내려받으므로, 폐쇄망/오프라인 빌드에서는 매번 접속 타임아웃 경고와 Log4j2 StatusLogger 에러
                 (플러그인 내부 로깅)를 유발한다. 빌드 성공에는 영향 없으나 불필요하므로 일반 빌드에서는
                 실행하지 않도록 phase 를 none 으로 둔다. 라이선스 목록이 필요할 때(온라인 환경) 수동 실행:
                     mvn org.codehaus.mojo:license-maven-plugin:2.4.0:download-licenses -Dlicense.phase= -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <version>2.4.0</version>
                <executions>
                    <execution>
                        <id>download-licenses</id>
                        <phase>none</phase>
                        <goals>
                            <goal>download-licenses</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- 알려진 취약점(CVE) 스캔용. 폐쇄망에서는 NVD 데이터를 미리 반입해서
                 data 옵션으로 지정하거나, mvn org.owasp:dependency-check-maven:check 로 수동 실행 -->
            <plugin>
                <groupId>org.owasp</groupId>
                <artifactId>dependency-check-maven</artifactId>
                <version>9.2.0</version>
                <configuration>
                    <failBuildOnCVSS>7</failBuildOnCVSS>
                    <format>HTML</format>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <image>
                        <builder>paketobuildpacks/builder-jammy-base:latest</builder>
                    </image>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <plugin>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <configuration>
                    <!-- yml 필터링 허용 -->
                    <nonFilteredFileExtensions>
                        <nonFilteredFileExtension>gif</nonFilteredFileExtension>
                        <nonFilteredFileExtension>jpg</nonFilteredFileExtension>
                        <nonFilteredFileExtension>png</nonFilteredFileExtension>
                        <nonFilteredFileExtension>ttf</nonFilteredFileExtension>
                        <nonFilteredFileExtension>woff</nonFilteredFileExtension>
                        <nonFilteredFileExtension>woff2</nonFilteredFileExtension>
                    </nonFilteredFileExtensions>
                </configuration>
                <executions>
                    <execution>
                        <id>copy-config-files</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/search_api/config</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>src/main/resources</directory>
                                    <filtering>true</filtering>
                                    <includes>
                                        <include>application-*.yml</include>
                                        <include>logback-spring.xml</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>

                    <execution>
                        <id>copy-scripts-folder</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/search_api</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>src/main/search_api</directory>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>1.8</version>
                <executions>
                    <execution>
                        <id>copy-war</id>
                        <phase>package</phase>
                        <configuration>
                            <target>
                                <mkdir dir="${project.build.directory}/search_api"/>
                                <mkdir dir="${project.build.directory}/search_api/tls"/>
                                <copy file="${project.build.directory}/${project.build.finalName}.war"
                                      tofile="${project.build.directory}/search_api/${project.build.finalName}.war"/>
                            </target>
                        </configuration>
                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>

        <finalName>elastic_api_standard</finalName>
    </build>

    <repositories>
        <repository>
            <id>spring-milestones</id>
            <name>Spring Milestones</name>
            <url>https://repo.spring.io/milestone</url>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
        <repository>
            <id>spring-snapshots</id>
            <name>Spring Snapshots</name>
            <url>https://repo.spring.io/snapshot</url>
            <releases>
                <enabled>false</enabled>
            </releases>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>spring-milestones</id>
            <name>Spring Milestones</name>
            <url>https://repo.spring.io/milestone</url>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </pluginRepository>
        <pluginRepository>
            <id>spring-snapshots</id>
            <name>Spring Snapshots</name>
            <url>https://repo.spring.io/snapshot</url>
            <releases>
                <enabled>false</enabled>
            </releases>
        </pluginRepository>
    </pluginRepositories>
</project>
