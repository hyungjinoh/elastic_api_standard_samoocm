# docker compose 용 값. `cp .env.example .env` 후 수정. .env 는 커밋 금지(.gitignore 권장).

# AES-256 키. 반드시 32바이트(영문/숫자 32자). SecurityModule 이 길이 검증 후 기동 실패시킴.
SECURITY_AES_KEY=0123456789abcdef0123456789abcdef

# Jasypt ENC() 복호화 키. 컨테이너 검증에선 DB 접속정보를 평문 env 로 override 하므로
# 실제 복호화는 일어나지 않지만, JasyptAesConfig 빈 초기화를 위해 비어있지 않아야 함.
JASYPT_ENCRYPTOR_PASSWORD=local-verify-only

# 공유 ES(docker/ 폴더)의 elastic 계정 비밀번호. docker/docker-compose.yml 의 ELASTIC_PASSWORD 기본값과 동일해야 함.
# 앱은 이 값으로 Basic 인증(elastic:비밀번호)하여 ES 에 접속한다.
ELASTIC_PASSWORD=elastic1234